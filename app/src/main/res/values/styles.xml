<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#23E2F4</item>
        <item name="android:statusBarColor">#05070C</item>
        <item name="android:navigationBarColor">#05070C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#05070C</item>
        <item name="android:alertDialogTheme">@style/BotnaDialogTheme</item>
    </style>
    <style name="BotnaDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#23E2F4</item>
        <item name="android:colorBackground">#0D111A</item>
        <item name="android:windowBackground">@drawable/dialog_glass_bg</item>
        <item name="android:textColorPrimary">#EBF6FF</item>
        <item name="android:textColorSecondary">#96AEC3</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:buttonStyle">@style/BotnaDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/BotnaDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/BotnaDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/BotnaDialogButton</item>
    </style>
    <style name="BotnaDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_button_glass_bg</item>
        <item name="android:textColor">#EBF6FF</item>
        <item name="android:allCaps">false</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
</resources>
